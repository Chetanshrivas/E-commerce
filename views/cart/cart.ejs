<%- include('../partials/header') %>
<% layout('layouts/boilerplate') -%>

<section class="container py-5">
  <h1 class="display-6 text-center mb-4">My Cart</h1>
  <div class="row">
    <div class="col-lg-8">
      <% if(user.cart.length > 0) { %>
        <% for(let item of user.cart){ %>
          <div class="card mb-3 shadow-sm">
            <div class="row g-0 align-items-center">
              <div class="col-md-4">
                <img src="<%=item.image%>" class="img-fluid rounded" alt="<%=item.name%>">
              </div>
              <div class="col-md-8">
                <div class="card-body">
                  <h5 class="card-title"><%=item.name%></h5>
                  <p class="card-text text-muted small"><%=item.description%></p>
                  <p class="card-text fw-bold text-primary">Rs. <%=item.price%></p>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <div class="alert alert-warning text-center">Your cart is empty.</div>
      <% } %>
    </div>
    
    <div class="col-lg-4">
      <div class="card shadow-lg p-3">
        <h5 class="card-title text-center mb-3">Order Summary</h5>
        <ul class="list-group list-group-flush">
          <% for(let item of user.cart) { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <%=item.name%>
              <span class="fw-bold">Rs. <%=item.price%></span>
            </li>
          <% } %>
          <li class="list-group-item fw-bold d-flex justify-content-between">
            Total Amount:
            <span class="text-success">Rs. <%=totalAmount%></span>
          </li>
        </ul>
        
        <% if(user.cart.length > 0) { %>
          <form action="/create-checkout-session" method="post" class="d-grid gap-2">
            <% for(let item of user.cart) { %>
              <input type="hidden" name="products[]" value='<%= JSON.stringify(item) %>'>
            <% } %>
            <button type="submit" class="btn btn-success btn-lg mt-3">Proceed to Checkout</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</section>
