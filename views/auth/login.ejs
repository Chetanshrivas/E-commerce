<% layout('layouts/boilerplate') %>

<%- include('../partials/flash') %>

<div class="row" >

    <div class="col-md-6 mx-auto" >

        <h1  class="display-6 mt-5 fw-bold fst-italic fs-1" > Login </h1>
        <form action="/login" method="post"> 

            <div class="mt-3">
                <label  class="form-label" for="username">Username:</label>
                <input  class= "form-control" type="text" id="username" name="username" placeholder="Enter your username">
            </div>

            <div class="mt-3">
                <label class="form-label" for="password">Password:</label>
                <input class= "form-control" type="password" id="password" name="password" placeholder="Enter your password">
            </div>

            <button type="submit" class=" btn btn-sm btn-success mt-3"> login </button>
            <p class="fw-light mt-2" > Don't have an account? <a href="/register" style="text-decoration: none;">Sing up</a> </p>
        </form>


