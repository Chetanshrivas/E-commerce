<% layout('layouts/boilerplate') %>

<%- include('../partials/header') %>

<%- include('../partials/flash') %>


<div class="row ">

  <!-- <%  if(msg && msg.length){ %>
    <div class="alert alert-success alert-dismissible fade show " role="alert">
      <strong> <%= msg %></strong>
      <button type="button" class="btn-close " data-bs-dismiss="alert" aria-label="Close"></button>
    </div>  
    <%  } %> -->

         
            <div class = "col-lg-6 mt-5 ">

                <div class="card shadow mx-auto" style="width: 25rem;">
                     <img src="<%=foundProduct.image%>" class="card-img-top" alt="...">
                    <div class="card-body">
                      <h5 class="card-title"><%=foundProduct.name%></h5>
                      <h5 class="card-title"> <%= foundProduct.price%> &#8377;</h5>
                      <p class="card-text"><%= foundProduct.description%></p>
                      <form method="POST" action="/user/<%=foundProduct._id%>/add" class="d-inline-block">
                        <button class="btn btn-sm btn-secondary">Add to Cart</button>
                      </form>
                      <% if(currentUser && currentUser.role === 'seller'){ %>
                        <a href="/products/<%=foundProduct._id%>/edit" class="btn btn-sm btn-light">Edit</a>
                      <% } %>

                    </div>
                </div>
            </div>


        <div class="col-lg-3 mt-3">
                <h3 class="display-5 fst-italic fw-bold">leave a Review</h3>

            <form action="/products/<%=foundProduct._id%>/review" method="POST">

                <div class = "mt-3">
                    <fieldset class="starability-basic">
                        <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="rating" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="rating" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="rating" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="rating" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="rating" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                      </fieldset>
                      
                </div>

                <div class = "mb-3">
                    <label class = "form-label" for="commt">Comment :</label>
                    <input class="form-control"  type="text" name="comment" id="commt">
                </div>

                <div class="card-body"><button class = "btn btn-sm btn-success">Add Review</button></div>

            </form>

            <div class="my-4">
               <% for( let review of foundProduct.reviews){  %>

                <div class="card mt-3">
                    <div class="card-header ratinginc"> Rating :  <div class = " mt-1"><p class="starability-result" data-rating="<%= review.rating %>">
                        Rated: <%= review.rating %></p></div>
                    </div>
                    <div class="card-body">
                      <h5 class="card-title">Comment :</h5>
                      <p class="card-text"><%= review.comment %></p>
                      <a href="#" class="btn  btn-sm  btn-danger">Delete</a>
                    </div>
                  </div>


              <%  }  %>

            </div>



        </div>
</div>
  
</body>
</html>